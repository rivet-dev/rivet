# MARK: Docker-specific
.git/
# The jj store mutates on every snapshot, so including it would invalidate
# every COPY of the repository on every build.
.jj/
.gitignore
.gitattributes
.dockerignore
**/Dockerfile*
**/docker-compose*.yml

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# Documentation
*.md
!README.md
docs/
LICENSE*
!LICENSE

# Editor configs
.vscode/
.idea/
*.swp
*.swo
*~

# MARK: Copied from .gitignore
**/.DS_Store

# Env
.env*.local

# Rust
**/target

# JavaScript
**/*.log*
!engine/sdks/schemas/**/*.bare
**/.cache/
**/.next/
**/.turbo
**/.yarn
**/dist/
**/node_modules/
**/target

# Frontend

# RivetKit packages (need pre-built dist for screenshot generation)
!rivetkit-typescript/packages/*/dist/
!engine/sdks/typescript/*/dist/
!shared/typescript/*/dist/

# pnpm content-addressable store (large, not needed for build)
.pnpm-store/

# Test snapshots (large LFS-tracked binaries, not needed for build)
engine/packages/test-snapshot-gen/snapshots/

# Credentials and secrets
secrets/

# BYOC customer state and generated installation inputs must never enter a build.
byoc/
**/rivet-credentials.json

# Not needed to build the engine binary
website/
# required when BUILD_FRONTEND=true.
!website/public/examples/

# mcp-hub depends on rivet-website (the website package), which is excluded
# above. Exclude mcp-hub so the pnpm workspace stays consistent.
rivetkit-typescript/packages/mcp-hub/
