{
  "name": "@rivetkit/svelte",
  "version": "0.1.0",
  "description": "Svelte 5 runes integration for RivetKit actors",
  "license": "Apache-2.0",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "svelte": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/__bench__"
  ],
  "scripts": {
    "build": "svelte-package -i src/lib",
    "check-types": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --environment jsdom src/lib/__tests__/*.test.ts",
    "bench": "vitest bench --run --environment jsdom src/lib/__bench__/*.bench.ts"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "dependencies": {
    "@tanstack/store": "^0.7.1",
    "esm-env": "^1.2.2",
    "fast-deep-equal": "^3.1.3",
    "rivetkit": "2.3.17"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.7",
    "jsdom": "^28.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.4.3",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "rivetkit",
    "svelte",
    "svelte5",
    "runes",
    "actors",
    "realtime",
    "websocket"
  ],
  "sideEffects": false
}
