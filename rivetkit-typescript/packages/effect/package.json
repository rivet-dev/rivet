{
	"name": "@rivetkit/effect",
	"version": "3.1.2-rc.9",
	"description": "Effect SDK for Rivet Actors",
	"license": "Apache-2.0",
	"type": "module",
	"sideEffects": false,
	"files": [
		"src/**/*.ts",
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"dist/**/*.d.ts.map"
	],
	"exports": {
		".": {
			"types": "./src/mod.ts",
			"workerd": "./src/mod.ts",
			"browser": "./src/mod.browser.ts",
			"default": "./src/mod.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/mod.d.ts",
				"workerd": "./dist/mod.js",
				"browser": "./dist/mod.browser.js",
				"default": "./dist/mod.js"
			}
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"lint:publint": "publint --strict",
		"lint:attw": "attw --pack . --profile esm-only",
		"test": "vitest --typecheck",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@rivet-dev/workflows": "^1.1.1"
	},
	"peerDependencies": {
		"effect": "^4.0.0",
		"rivetkit": "workspace:*"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.3",
		"@effect/language-service": "^0.85.1",
		"@effect/vitest": "^4.0.0",
		"@types/node": "^22.18.1",
		"@vitest/coverage-v8": "^5.0.3",
		"effect": "4.0.0",
		"esbuild": "^0.27.3",
		"publint": "^0.3.21",
		"rivetkit": "workspace:*",
		"typescript": "^5.9.2",
		"vitest": "^5.0.3"
	}
}
