{
	"name": "@rivet-dev/sandbox-adapter",
	"version": "2.3.20",
	"description": "Sandbox providers for agent harnesses running in Rivet Actors",
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist",
		"package.json"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./agentos": {
			"types": "./dist/agentos.d.ts",
			"default": "./dist/agentos.js"
		},
		"./e2b": {
			"types": "./dist/e2b.d.ts",
			"default": "./dist/e2b.js"
		},
		"./daytona": {
			"types": "./dist/daytona.d.ts",
			"default": "./dist/daytona.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit"
	},
	"peerDependencies": {
		"@daytonaio/sdk": "^0.216.0",
		"e2b": "^2.51.0"
	},
	"peerDependenciesMeta": {
		"@daytonaio/sdk": {
			"optional": true
		},
		"e2b": {
			"optional": true
		}
	},
	"devDependencies": {
		"@daytonaio/sdk": "^0.216.0",
		"@types/node": "^24.0.0",
		"e2b": "^2.51.0",
		"typescript": "^5.9.2"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
