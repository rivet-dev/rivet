{
	"name": "@rivet-dev/claude-code",
	"version": "2.3.20",
	"description": "Run Claude Code agents as durable Rivet Actors on your own Claude Code login.",
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"keywords": [
		"rivetkit",
		"rivet",
		"claude",
		"claude-code",
		"agents",
		"actor",
		"durable",
		"ai"
	],
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check-types": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.304",
		"rivetkit": "workspace:*",
		"zod": "^4.1.0"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^5.5.2",
		"vitest": "^3.1.1"
	},
	"engines": {
		"node": ">=22.6.0"
	}
}
