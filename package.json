{
	"license": "Apache-2.0",
	"name": "@rivetkit/engine-workspace",
	"private": true,
	"packageManager": "pnpm@10.13.1",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"start": "pnpm exec turbo watch build",
		"build": "pnpm exec turbo build build:embed --concurrency=1",
		"test": "pnpm exec turbo test",
		"test:watch": "pnpm exec turbo watch test",
		"check-types": "pnpm exec turbo check-types",
		"counter-latency": "pnpm --dir examples/kitchen-sink counter-latency",
		"slow-reconnect": "pnpm --dir examples/kitchen-sink slow-reconnect",
		"lint": "pnpm biome check .",
		"fmt": "pnpm biome format --write .",
		"fmt:agent": "node ./scripts/format/agent-format.mjs",
		"docs:gen-api": "node ./scripts/docs/gen-api-reference.mjs",
		"docs:check-api": "node ./scripts/docs/gen-api-reference.mjs --check"
	},
	"devDependencies": {
		"@bare-ts/tools": "0.15.0",
		"@biomejs/biome": "^2.3",
		"commander": "^12.1.0",
		"lefthook": "^1.12.4",
		"semver": "^7.7.3",
		"tsup": "^8.5.0",
		"turbo": "^2.5.6",
		"typescript": "^5.9.2",
		"zx": "^8.8.5"
	},
	"dependencies": {
		"@babel/runtime": "^7.29.2",
		"@iarna/toml": "^2.2.5",
		"@sentry/vite-plugin": "^2.23.1",
		"fast-glob": "^3.3.3",
		"handlebars": "^4.7.9"
	},
	"resolutions": {
		"@rivetkit/engine-api-full": "workspace:*",
		"@types/react": "^19",
		"@types/react-dom": "^19"
	},
	"pnpm": {
		"overrides": {
			"react": "19.1.0",
			"react-dom": "19.1.0",
			"rivetkit": "workspace:*",
			"rivetkit>drizzle-orm": "0.45.2",
			"@rivetkit/engine-api-full": "workspace:*",
			"@flue/sdk": "1.0.0-beta.9",
			"@codemirror/state": "6.5.2",
			"@codemirror/view": "6.38.2",
			"@codemirror/autocomplete": "6.18.7",
			"@codemirror/commands": "6.8.1",
			"@codemirror/lint": "6.8.5"
		}
	}
}
