#import "shared/depot.types.v1.bare"
#import "shared/depot.fs.v2.bare"
#import "depot.client_protocol.v2.bare"

# Where one of a volume's logs stood when the tablet maintainer decided an op of that volume.
# The maintainer holds the log's apply at this position until the op is applied, and replay
# applies the op once every log it targets reaches its position again, so the logs merge in
# the order the live maintainer applied them. An op of a volume with one claim has one target.
type MaintainerOpTarget struct {
	volumeLogKey: VolumeLogKey
	after: VolumeLogPosition
}

# A checkpoint create, delete or retention change made without a holder. The op is the
# intent: replay runs the same guarded store change, at `targets`, with the logged time.
type CheckpointOp struct {
	request: VolumeCheckpointRequest
	createdAtUnixMs: i64
	# Empty for a change of a retired incarnation, which has no volume log.
	targets: list<MaintainerOpTarget>
}

# A retention checkpoint the maintainer takes on its schedule, at the targets' positions.
type RetentionCheckpointOp struct {
	targets: list<MaintainerOpTarget>
	createdAtUnixMs: i64
}

# A fork source change at a parent in this tablet: an acquire, which pins the parent at the
# targets, or a release a destination asked for.
type ForkReferenceOp struct {
	request: FsForkReferenceRequest
	createdAtUnixMs: i64
	targets: list<MaintainerOpTarget>
}

# Publishes a fork destination, or a restore's new incarnation over the one it replaces. The copied
# metadata pages are not in the log, so a replay that cannot find the publication in the store
# prepares the fork again with `image` and copies the pages again from the parent, whose hold keeps
# them, before the destination serves. A restore's op is logged after its drain claimed the replaced
# incarnation's replicas and names that incarnation, at the image position when the image is its own
# checkpoint: replay publishes only once the replaced incarnation is registered and its apply
# reached the image again, because the replaced log stays live until a pass covers the publication.
#
# `incarnationEpoch` orders the published incarnation among its name's incarnations. It is
# drawn when the op is made, so every replay publishes the same one.
type ForkPublishOp struct {
	spec: FsForkSpec
	image: FsForkImage
	targets: list<MaintainerOpTarget>
	incarnationEpoch: u64
	# The group's latest fork when a lazy fork's record is published, stamped on the record;
	# absent for a fork outside any group.
	createdAtFork: optional<u64>
}

# Fails a fork whose publication was logged. The client is told it failed only once this op
# commits, so a replay skips the earlier publication of the same spec and fails it again.
type ForkFailOp struct {
	spec: FsForkSpec
	error: FsForkError
}

# An operator repair call's audit, logged before the call's effect with no outcome and again
# after it with the outcome. Its apply writes the row beside the volume's own rows, keyed by
# the call's operation id, so the last logged state of each call is listable, moves with a
# split and survives a maintainer restart. It changes nothing else.
type RepairAuditOp struct {
	row: RepairAuditRow
}

# A fork pin a parent volume takes before applying its first entry after one or more forks of
# its group. The op is the pin row verbatim plus its creation time, which replay cannot read
# from a clock: apply and replay write exactly this row at `cut`, whatever the group's latest
# fork number is by then, so a pin never claims a fork it did not stand for. The op names no
# group, since the group is in the volume's key, and no targets, which are the cut's claim logs
# at their positions. Dropping archived children from the volume's earlier pins is not part of
# the op: archive is final and the drop idempotent, so the next pin or load of the volume makes
# it.
type ForkPinOp struct {
	volumeLogKey: VolumeLogKey
	cut: FsCut
	firstFork: u64
	lastFork: u64
	waiting: list<FsGroupId>
	createdAtUnixMs: i64
}

type MaintainerOp union {
	CheckpointOp | RetentionCheckpointOp | ForkReferenceOp | ForkPublishOp | ForkFailOp | RepairAuditOp | ForkPinOp
}

# The payload of one maintainer log entry: every op batched into one append.
type MaintainerEntry struct {
	ops: list<MaintainerOp>
}

# The tablet store's record of its maintainer log, written by ordinary passes. Trims of
# the log never pass `cold`.
type MaintainerLogRecord struct {
	tabletId: UuidV4
	cold: VolumeLogPosition
	# The highest version of each family written into this tablet's SlateDB data, raised in the
	# same pass write as the first row at a higher version and copied to split children.
	versionMarks: list<VersionMark>
}

# What a volume's creating load stores in its replicas' state, so a maintainer that finds
# the volume before its first record reached cold still knows how it was created.
type VolumeCreation struct {
	# The record's `incarnationEpoch`, which orders the incarnations of one name.
	incarnationEpoch: u64
	# A fork destination's links to the volumes it reads through.
	baseChain: list<FsBaseLink>
	retention: optional<FsRetentionPolicy>
	# The record's `createdAtFork`, `lazyFork` and `metadataLocal`, which only the record
	# carries otherwise: a volume whose first record never reached cold keeps its place in its
	# group's forks, its fork origin and its metadata reads.
	createdAtFork: optional<u64>
	lazyFork: optional<FsLazyForkOrigin>
	metadataLocal: bool
}
