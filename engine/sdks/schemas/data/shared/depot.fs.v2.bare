#import "shared/depot.types.v1.bare"

type FsKind enum { FILE DIR SYMLINK FIFO SOCKET CHARDEV BLOCKDEV KV }
type FsTimes struct { atime: i64 mtime: i64 ctime: i64 }
type FsInode struct {
    kind: FsKind
    mode: u32
    uid: u32
    gid: u32
    rdev: u64
    size: u64
    nlink: u64
    times: FsTimes
    parent: u64
    inline: optional<data>
    # Highest inherited byte exclusive. Shrink only lowers this; seq-0 copies
    # remain inherited, while positive-seq local writes take precedence.
    inheritedLimit: optional<u64>
    target: data
    entries: u64
    xattrs: u64
}
type FsDentry struct { child: u64 kind: FsKind }
type FsDeleted void
# A range whiteout: the KV keys of one file from `start` (the row's key, inclusive) to `end`
# (exclusive, unbounded when absent) are absent in this volume however its base links read them.
# A range delete writes one on a volume with a base; the volume's own rows in the range stay
# visible, since a level never hides itself, and its deleted rows are tombstones of their own.
type FsKvRangeWhiteout struct { end: optional<data> }
type FsPresent void
type FsBytes data

type FsInodeUpdate struct { ino: u64 inode: FsInode }
type FsChunkUpdate struct { index: u64 bytes: data }

# Complete postimages avoid replay-time reads of partially updated inodes.
type FsCreate struct { parent: FsInodeUpdate name: data inode: FsInode }
type FsMkdir struct { parent: FsInodeUpdate name: data inode: FsInode }
type FsSymlink struct { parent: FsInodeUpdate name: data inode: FsInode }
type FsMknod struct { parent: FsInodeUpdate name: data inode: FsInode }
# Immutable filesystem format, persisted atomically with the initial root.
type FsFormat struct { inlineMaxBytes: u64 }
type FsRoot struct { inode: FsInode format: FsFormat }
type FsLink struct { parent: FsInodeUpdate name: data target: FsInodeUpdate }
type FsUnlink struct { parent: FsInodeUpdate name: data target: FsInodeUpdate }
type FsRename struct {
    fromParent: FsInodeUpdate
    fromName: data
    toParent: FsInodeUpdate
    toName: data
    target: FsInodeUpdate
    replaced: optional<FsInodeUpdate>
}
type FsSetAttr struct { target: FsInodeUpdate chunks: list<FsChunkUpdate> dropChunksFrom: optional<u64> }
type FsWrite struct { target: FsInodeUpdate chunks: list<FsChunkUpdate> }
type FsSetXattr struct { target: FsInodeUpdate name: data value: data }
type FsRemoveXattr struct { target: FsInodeUpdate name: data }
type FsReclaim struct { ino: u64 }
type FsKvPut struct { ino: u64 key: data value: data }
type FsKvDelete struct { ino: u64 key: data }
type FsKvDeleteRange struct { ino: u64 start: data end: optional<data> }
type FsCheckpoint struct { name: data createdAt: i64 }

# One claim log's position in a cut.
type FsClaimLogPosition struct { claimLog: u16 position: VolumeLogPosition }
# A position that spans a volume: one position per claim log of its claim table, ordered by
# claim log. A read at a cut returns the newest version of a row whose log the cut names, at or
# below that log's position; a version of a log the cut does not name is invisible. A volume with
# one claim has cuts of one entry, for claim log 0.
type FsCut struct { logs: list<FsClaimLogPosition> }

# `cut` is the checkpoint's position over every claim log. Its claim log 0 entry is the row key's
# sequence with `clientEpoch`. Absent in a row written before cuts existed; a reader derives the
# one-log cut from the key then.
type FsVolumeCheckpoint struct {
    named: bool
    retention: bool
    createdAt: i64
    clientEpoch: u64
    cut: optional<FsCut>
}
# `cut` is the held position over every claim log, absent in a row written before cuts existed.
type FsForkHold struct {
    forkVolumeKey: VolumeKey
    forkRegion: u16
    createdAt: i64
    cut: optional<FsCut>
}
# The id of a volume group: the partition key hash of the group's own key.
type FsGroupId data[16]
# A link into a base volume. `forkPin` names a fork pin on the base by its first fork number, for
# a volume made by a group fork; `checkpointName` is then empty. A link made by an explicit fork
# names a checkpoint and leaves `forkPin` absent.
type FsBaseLink struct {
    volumeKey: VolumeKey
    incarnation: UuidV4
    checkpointName: data
    position: FsCut
    region: optional<u16>
    forkPin: optional<u64>
}
# A fork pin: a checkpoint-like row a parent volume takes before its first write after one or
# more forks of its group, keyed by the sequence it pins and the first fork number it stands for.
# It stands for the forks `firstFork..=lastFork`; `waiting` lists the child groups of those forks
# that are not yet archived and only ever shrinks; the pin is deleted once it is empty.
type FsForkPin struct {
    createdAt: i64
    lastFork: u64
    cut: FsCut
    waiting: list<FsGroupId>
}
# Where a volume made by a group fork came from: the parent group and the fork number in it.
type FsLazyForkOrigin struct { parent: FsGroupId forkNumber: u64 }
type FsVolumeStatus enum { LIVE DELETED }
type FsRetentionPolicy struct { intervalMs: u64 count: u32 }
# Last 64 mutation identities, ordered by client sequence. Flushed atomically with
# the cold watermark so trimming cannot erase proof of an uncertain write.
type FsWriteReceipt struct { clientSeq: u64 requestId: UuidV4 payloadDigest: data[16] volumeSeq: u64 }
type FsVolumeRecord struct {
    partitionKey: data
    name: optional<data>
    volumeIncarnation: UuidV4
    status: FsVolumeStatus
    cold: VolumeLogPosition
    baseChain: list<FsBaseLink>
    retention: optional<FsRetentionPolicy>
    recentWrites: list<FsWriteReceipt>
    # Orders the incarnations of one name: drawn from the tablet's claim epoch counter when
    # the incarnation is created, so a later incarnation always has a higher one. The name's
    # pointer row holds the stored record with the highest.
    incarnationEpoch: u64
    # The last fork number of the volume's group this volume has a fork pin for. Absent for a
    # volume outside any group, and rebuilt from the pin rows at load.
    forkPinnedThrough: optional<u64>
    # The group's latest fork number when this incarnation was created, so an acquire for an
    # earlier fork number passes this incarnation over. Absent outside a group.
    createdAtFork: optional<u64>
    # The group's latest fork number when this incarnation was deleted; set only on a tombstone
    # record or an archive.
    deletedAtFork: optional<u64>
    # Set on a volume made by a group fork, which reads through its base chain.
    lazyFork: optional<FsLazyForkOrigin>
    # Whether the volume's metadata rows were copied in at creation, so reads of metadata never
    # consult the base chain; chunks are read through it regardless.
    metadataLocal: bool
}

# Discovery is an index into the exact ForkReference receipt, which owns the
# destination region and resolved checkpoint. It never resolves a selector again.
type FsPendingForkCheck struct { forkIncarnation: UuidV4 createdAt: i64 }
type FsChunkPosition struct { ino: u64 index: u64 }
# Enumerate sparse chunk keys one base layer at a time. Every candidate is
# resolved through the complete fixed image before copying it at sequence zero.
type FsMaterializeCursor struct { layer: u32 after: optional<FsChunkPosition> completeImage: bool }
type FsPendingMaterialize struct { incarnation: UuidV4 cursor: FsMaterializeCursor }
type FsPendingSweep struct { incarnation: UuidV4 cursor: optional<data> }
type FsDirectoryCursor struct {
    incarnation: UuidV4
    session: UuidV4
    directory: u64
    appliedSeq: u64
    lastName: data
}

# Exact identity remains available after writer changes and across restore.
type FsCheckpointInfo struct {
    name: data
    volumeIncarnation: UuidV4
    position: FsCut
    checkpoint: FsVolumeCheckpoint
}


# Fork commands use topology's regional datacenter label, never a worker ID.
# The operation ID is also the new incarnation and remains stable across retries.
type FsForkLatest void
type FsForkNamed struct { incarnation: optional<UuidV4> name: data }
type FsForkAtTime struct { unixMs: i64 }
# The parent's state as of a fork of its group: the fork pin covering `forkNumber`, taken now
# if none does yet.
type FsForkGroup struct { forkNumber: u64 }
type FsForkSelector union { FsForkLatest | FsForkNamed | FsForkAtTime | FsForkGroup }
type FsForkMinimum struct { incarnation: UuidV4 position: FsCut }
type FsForkSpec struct {
    operationId: UuidV4
    parentVolumeKey: VolumeKey
    parentRegion: u16
    destinationVolumeKey: VolumeKey
    destinationRegion: u16
    selector: FsForkSelector
    minimum: optional<FsForkMinimum>
    # A restore must still replace this exact incarnation at publication.
    restore: optional<UuidV4>
}
# Administrative ops, each applied in log order by the cold apply, so a crash replays them
# with the entries around them. Each stands alone in its entry, outside any transaction.
#
# Clears the `named` flag of checkpoint `name` of `incarnation` (this volume's or an older
# one). The last hold removes the row; an older incarnation nothing else retains is then
# marked for sweeping.
type FsCheckpointRelease struct { name: data incarnation: UuidV4 }
# Sets this volume's retention policy; absent restores the default.
type FsRetentionSet struct { policy: optional<FsRetentionPolicy> }
# Removes the hold this fork has on this volume. With no reference it keeps the terminal
# `Released` receipt that fences a late acquire.
type FsForkHoldRelease struct { spec: FsForkSpec }
# Removes only the pending check of a fork the check found present.
type FsForkCheckDone struct { spec: FsForkSpec }
type FsOp union {
    FsRoot | FsCreate | FsMkdir | FsSymlink | FsMknod | FsLink | FsUnlink |
    FsRename | FsSetAttr | FsWrite | FsSetXattr | FsRemoveXattr | FsReclaim |
    FsKvPut | FsKvDelete | FsKvDeleteRange | FsCheckpoint |
    FsCheckpointRelease | FsRetentionSet | FsForkHoldRelease | FsForkCheckDone
}
type FsForkImage struct { link: FsBaseLink parentBase: list<FsBaseLink> }
type FsForkReceipt struct { spec: FsForkSpec image: FsForkImage }
# This receipt survives removal of the discovery check. A delayed duplicate
# AddForkReference must not resolve Latest against a newer source incarnation.
type FsForkReferenceHeld struct { receipt: FsForkReceipt createdAt: i64 }
# A terminal receipt rejects late duplicate acquires after the fork was deleted.
type FsForkReferenceReleased struct { spec: FsForkSpec }
type FsForkReference union { FsForkReferenceHeld | FsForkReferenceReleased }
type FsForkAcquirePending void
type FsForkCopying struct { image: FsForkImage cursor: optional<data> }
# `metadataLocal` says the copy wrote the parent's metadata rows into the fork, so its reads of
# them never consult the base chain; a group fork over the inline threshold leaves it unset.
type FsForkReady struct { image: FsForkImage metadataLocal: bool }
type FsForkPreparation union { FsForkAcquirePending | FsForkCopying | FsForkReady }
type FsPendingFork struct { spec: FsForkSpec preparation: FsForkPreparation }
# The current record is authoritative while it names this incarnation. On
# replacement or logical deletion this archive retains its exact source chain.
type FsIncarnationRecord struct { record: FsVolumeRecord creation: optional<FsForkReceipt> }
# Written atomically with removal of links, deleted only after source confirms.
type FsPendingForkRelease struct { spec: FsForkSpec }


# `TAIL_UNPROVEN` refuses a `Latest` fork for now: the parent's members hold a tail above what
# they prove committed, and nothing proved it before the acquire's deadline. A recovery of the
# parent proves it: an open by a new claimant, or the parent's holder-gone or idle unload.
type FsForkError enum {
    INVALID BUSY DESTINATION_EXISTS OPERATION_CONFLICT FORK_DELETED
    VOLUME_NOT_FOUND VOLUME_DELETED INCARNATION_CHANGED LAGGING
    CHECKPOINT_NOT_FOUND CHECKPOINT_NOT_REACHABLE CHECKPOINT_AMBIGUOUS
    FORK_OUT_OF_RETENTION FORK_CHAIN_TOO_DEEP BASE_UNAVAILABLE REGION_UNAVAILABLE
    TAIL_UNPROVEN
}

# A point from the source enumeration with its fully resolved image bytes.
type FsMaterializedChunk struct { position: FsChunkPosition bytes: optional<data> }

# Terminal negative identity survives releasing the logical destination name.
type FsForkFailure struct { spec: FsForkSpec error: FsForkError }

type FsForkPresence enum { PREPARING PRESENT ABSENT }
