#import "shared/uuid_v4.v1.bare"
#import "shared/depot.alarms.v1.bare"
#import "shared/depot.types.v1.bare"

type Uuid data
type Id data
type WorkerId data

# One individual actor fork in a chain: the source actor, its key, and when the fork was made,
# which is the forked actor's create time.
type ActorForkLink struct {
    actorId: Id
    key: optional<str>
    forkedAt: i64
}

# Where a forked actor's database came from: the source actor, its key, and the database
# volume the fork copied, with its group and incarnation. `forkId` is drawn by the fork request
# and names this one fork: the start command carries it, so the actor's runtime tells a first
# start of the fork from a later one, and the request tells its own create from a concurrent
# fork that took the same key.
type ActorForkSource struct {
    forkId: Uuid
    actorId: Id
    key: optional<str>
    databaseVolume: VolumeKey
    # The source's own fork chain, oldest first: every individual actor fork behind the source,
    # not this one. Empty when the source was never forked. At most `MAX_FORK_CHAIN_DEPTH` links,
    # since Depot refuses a deeper fork. The start command carries it, so the forked actor's
    # runtime keeps the chain even when the copied database does not hold it yet.
    chain: list<ActorForkLink>
}

# An actor's record. It names no namespace, because a fork carries it into another one: the
# namespace comes from the request, or from the group the actor's volume key is in.
type ActorData struct {
    actorId: Id
    poolName: str
    name: str
    key: optional<str>
    input: optional<data>
    createUnixMs: i64
    # Legacy: the namespace of an actor whose volumes are unprefixed, whose key does not say
    # whose it is. Records from before namespaces had groups named their namespace; new records
    # name none. Set from version 1's `namespace` by the upgrade, and by a create on unprefixed
    # keys, which only a namespace without a group makes while older binaries run. Read only by
    # the checks of unprefixed volumes. Removed in 3.1 with the backfill.
    legacyNamespace: optional<str>
    # The source actor this incarnation's database was copied from, for an actor made by an
    # individual actor fork. Absent for an ordinary create.
    forkedFrom: optional<ActorForkSource>
    # Legacy: the unprefixed actor this one was moved from by its namespace's backfill. Absent
    # for every other create. Removed in 3.1 with the backfill.
    legacyMovedFrom: optional<Id>
}

type ActorAllocation struct {
    envoyKey: str
    workerId: WorkerId
    connectionId: Uuid
}

type ReserveEpoxyPhasePending void
type ReserveEpoxyPhaseReserved void
type ReserveEpoxyPhaseAlreadyReserved struct {
    reservationId: Id
}
type ReserveEpoxyPhaseFailed void
type ReserveEpoxyPhaseMaxAttemptsReached void
# V2 holds the key of the namespace migrating in, so the key is V2's and nothing was reserved.
type ReserveEpoxyPhaseInV2 void

type ReserveEpoxyPhase union {
    ReserveEpoxyPhasePending |
    ReserveEpoxyPhaseReserved |
    ReserveEpoxyPhaseAlreadyReserved |
    ReserveEpoxyPhaseFailed |
    ReserveEpoxyPhaseMaxAttemptsReached |
    ReserveEpoxyPhaseInV2
}

type ReserveEpoxyState struct {
    phase: ReserveEpoxyPhase
    attempt: u32
    createUnixMs: i64
}

# Settles who owns the actor's key: this datacenter, once Epoxy reserves it here, another
# datacenter that already reserved it, or V2, when a create's namespace migrates in from V2 and
# V2 already holds the key.
type ReserveEpoxyEffectData struct {
    name: str
    key: optional<str>
    state: ReserveEpoxyState
}

type PendingNone void
type PendingSleep void
type PendingDestroy void
type PendingReallocate void

type PendingAction union {
    PendingNone |
    PendingSleep |
    PendingReallocate |
    PendingDestroy
}

# Legacy: the backfill's move of an unprefixed actor into its namespace's group. The new
# incarnation keeps the old one's creation time and scheduled alarm, takes its database as a
# Depot fork of `database` (absent when the old actor never opened one), and is held in
# `Initializing` until the backfill's `LegacyMoveConfirm`, after which it sleeps or starts: it
# is the same actor moving, so no fork hook runs. Every incarnation's creation time exceeds the
# previous one's at its state volume, which fences that incarnation's late results, so a move
# redone after an earlier attempt's copy was abandoned there lists one millisecond later than
# the old actor; a first move keeps it exactly. `mover` is the mover token of the backfill
# page that made it (see `LegacyMarkMoving`), which `LegacyMoveConfirm` must name and which a
# `LegacyMoveAbandon` must be at least. Removed in 3.1 with the backfill.
type LegacyActorMove struct {
    movedFrom: Id
    createUnixMs: i64
    alarmUnixMs: optional<i64>
    database: optional<ActorForkSource>
    mover: u64
}

# Legacy: what a moved actor holds until its move is confirmed: the old actor's scheduled
# alarm, armed only by the confirm, so it never fires during the move. Removed in 3.1 with the
# backfill.
type LegacyMoveHold struct {
    alarmUnixMs: optional<i64>
    # See `LegacyActorMove.mover`.
    mover: u64
}

type ActorCreateData struct {
    actorId: Id
    poolName: str
    name: str
    key: optional<str>
    input: optional<data>
    # Legacy: see `ActorData.legacyNamespace`, which the create copies. Removed in 3.1 with the
    # backfill.
    legacyNamespace: optional<str>
    # Set by an individual actor fork: the new incarnation's database volume is a Depot fork of
    # this source's, made in `Initializing` before the first start.
    forkFrom: optional<ActorForkSource>
    # Legacy: see `LegacyActorMove`. Removed in 3.1 with the backfill.
    legacyMove: optional<LegacyActorMove>
}

type ForkDatabasePhasePreparing void
# The prepared fork body, encoded with `depot_client::forks::encode_spec`. Persisted before it
# is sent, so every resend joins the same Depot fork job.
type ForkDatabasePhasePrepared struct {
    spec: data
}
type ForkDatabasePhaseForked void

# Why a database fork failed for good.
type ForkDatabaseFailure enum {
    # The source's database is already at Depot's fork chain depth limit.
    CHAIN_TOO_DEEP
    # The source's database volume is missing or was deleted.
    SOURCE_GONE
    # Depot refused the fork for another permanent reason.
    REJECTED
    # Every attempt failed or timed out.
    MAX_ATTEMPTS_REACHED
}

type ForkDatabasePhaseFailed struct {
    failure: ForkDatabaseFailure
}

type ForkDatabasePhase union {
    ForkDatabasePhasePreparing |
    ForkDatabasePhasePrepared |
    ForkDatabasePhaseForked |
    ForkDatabasePhaseFailed
}

# The progress of a database fork, persisted in `Initializing.forkDatabase` and also sent as an
# event.
#
# As an event. When: the actor executor finished one step of `ForkDatabase`: it prepared the
# body, the Depot fork published, or Depot refused it for good. State: `forkDatabase.state`
# takes the reported phase; a report for another incarnation or attempt, received outside
# `Initializing`, or for a step the fork has left changes nothing. A `Prepared` report at
# `Prepared` replaces the body: the executor prepared it again after the old body's job failed
# for good on a source with no record yet, which its open made; past the replacement cap counted
# in `replacements`, the report fails the fork instead. Effects: `Prepared` cancels
# the attempt's timer, executes `ForkDatabase` with the persisted body and arms the next
# attempt's timer; `Forked` cancels the timer and lets the start proceed; `Failed` cancels the
# timer and destroys the actor.
type ForkDatabaseState struct {
    phase: ForkDatabasePhase
    attempt: u32
    createUnixMs: i64
}

type ForkDatabaseEffectData struct {
    source: ActorForkSource
    state: ForkDatabaseState
    # Refusals in a row since the fork last reached a new step, which set the growing backoff
    # of the next retry. Reset by every accepted step result.
    refusals: u32
    # Bodies replaced so far: each one followed an open of a source that had no record in this
    # group. Capped on its own, apart from the attempt counter that timeouts also advance, so a
    # fork that timed out many times can still replace its body.
    replacements: u32
    # Refusals in a row because the source's tail is unproven. While nonzero, the executor proves
    # the tail before it resends the prepared body: it opens the source's database volume if the
    # source actor is asleep, so the open's recovery proves the tail, and asks the engine worker
    # holding the database of a running source to commit an entry of its own claim. Reset by every
    # accepted step result and by a refusal for another reason.
    tailUnprovenRefusals: u32
}

type Initializing struct {
    reserveEpoxy: ReserveEpoxyEffectData
    allocation: optional<ActorAllocation>
    # The database fork of a forked actor, which runs once the key is reserved and must finish
    # before the first start. Absent for an ordinary create.
    forkDatabase: optional<ForkDatabaseEffectData>
    # Legacy: present while a moved actor waits for the backfill's `LegacyMoveConfirm`. The
    # actor stays `Initializing` until then even with its key reserved and its database copied,
    # so it cannot start before the backfill proved its claim on the old database and destroyed
    # the old actor. Removed in 3.1 with the backfill.
    legacyMove: optional<LegacyMoveHold>
}

type Starting struct {
    allocation: ActorAllocation
}

type Running struct {
    allocation: ActorAllocation
}

type Sleeping struct {
    wakeRetries: u32
}

type Stopping struct {
    allocation: ActorAllocation
}

type DestroyPhasePending void
type DestroyPhaseSuccess void
type DestroyPhaseFailed void

type DestroyPhase union {
    DestroyPhasePending |
    DestroyPhaseSuccess |
    DestroyPhaseFailed
}

type DestroyState struct {
    phase: DestroyPhase
    attempt: u32
    createUnixMs: i64
}

type DestroyEffectData struct {
    createUnixMs: i64
    state: DestroyState
}

# Another datacenter reserved the key first, under `reservationId`.
type KeyOwnerDatacenter struct {
    reservationId: Id
}

# V2 holds the key of the namespace migrating in.
type KeyOwnerV2 void

# Who owns the key of an incarnation destroyed because its reservation found another owner.
type KeyOwner union {
    KeyOwnerDatacenter |
    KeyOwnerV2
}

# `keyOwner` is set when the incarnation is destroyed because its key belongs elsewhere: a create
# meanwhile is told so, and a key that belongs to V2 ends delegated to V2 instead of destroyed.
type Destroying struct {
    destroy: DestroyEffectData
    keyOwner: optional<KeyOwner>
}

type Destroyed void

# Held by the V2 migrator under `migrationId` while the actor's data is imported from V2 and V2
# gives the actor up. Its data record exists, but nothing starts it. A held actor that began here
# reserves its key in `reserveEpoxy`, as `Initializing` does, and is activated only once the key
# is reserved. A recalled actor has no `reserveEpoxy`: it reserved its key before it first slept.
type MigratingFromV2 struct {
    migrationId: u64
    reserveEpoxy: optional<ReserveEpoxyEffectData>
    # The actor's own alarm came due while it was held, so an activation that keeps the actor's
    # alarm wakes it at once.
    alarmDue: bool
}

# While its namespace migrates in from V2, the key belongs to V2: a create placed it there, by
# `create_ratio` or because V2 already held it, and every later create follows that instead of
# deciding again. It has no data record and nothing starts it. The V2 migrator's begin takes it
# over when it moves the actor in.
type DelegatedToV2 void

type ActorPhase union {
    Initializing |
    Starting |
    Running |
    Stopping |
    Sleeping |
    Destroying |
    Destroyed |
    MigratingFromV2 |
    DelegatedToV2
}

type StartWaiter struct {
    workerId: WorkerId
    waitId: u64
    expiresUnixMs: i64
}

type WriteIndexPhasePending void
type WriteIndexPhaseSuccess void
type WriteIndexPhaseFailed void

type WriteIndexPhase union {
    WriteIndexPhasePending |
    WriteIndexPhaseSuccess |
    WriteIndexPhaseFailed
}

type WriteIndexState struct {
    phase: WriteIndexPhase
    attempt: u32
    createUnixMs: i64
}

type WriteIndexEffectData struct {
    name: str
    createUnixMs: i64
    state: WriteIndexState
}

# Where an incarnation's database came from. Only a created one is empty on its first start.
type StorageOrigin enum {
    CREATED
    IMPORTED
}

type DatabaseEmpty void
type DatabaseForked void
type DatabaseForkFailed struct {
    failure: ForkDatabaseFailure
}

# How the current incarnation's database volume began, written by `initialize`: empty, as a
# Depot fork of a source actor's, or never, because the fork failed and the incarnation was
# destroyed.
type ActorDatabaseOrigin union {
    DatabaseEmpty |
    DatabaseForked |
    DatabaseForkFailed
}

# Legacy: the backfill moves this unprefixed actor into its namespace's group under `mover`, the
# token of the page doing it. Set by `LegacyMarkMoving`, from before the move claims the old
# database. While set, nothing starts the actor: a wake answers `TryStartLegacyMoving`, and an
# alarm that comes due is kept in `deferredAlarmUnixMs` for the move to carry instead of firing.
# The mark ends when its `LegacyMovingTimeout`, armed for the mark's duration, fires with no newer
# mark, so a move that stopped making progress never refuses wakes for longer than one page. The
# job's `LegacyMoveDestroy` and `LegacyClearMoving` under this mover end it sooner; a newer mover
# replaces it, and an ordinary destroy drops it. When the mark ends without a destroy, a deferred
# alarm fires at once and the mark becomes `LegacyMoveMarkCleared`. Removed in 3.1 with the
# backfill.
type LegacyMoveMarkMoving struct {
    mover: u64
    deferredAlarmUnixMs: optional<i64>
}
# Legacy: the old actor was destroyed by the move of `mover`, whose claim check passed: its held
# copy, the one whose `LegacyMoveHold.mover` is `mover`, is the actor now and is confirmed. Kept
# through `Destroying` and `Destroyed`. Removed in 3.1 with the backfill.
type LegacyMoveMarkMoved struct {
    mover: u64
}
# Legacy: on a moved copy, an ordinary destroy reached it while it was held for its confirm, so
# a request destroyed the actor: the backfill destroys the old actor too instead of moving it
# again. Removed in 3.1 with the backfill.
type LegacyMoveMarkCopyDestroyed void
# Legacy: a moving mark ended without a destroy, by its page's clear or at its deadline. `mover`
# is the highest mover the actor has seen, so a later `LegacyMarkMoving` below it, from a page
# that outlived its turn, is refused: the actor serves wakes until a newer page marks it.
# Removed in 3.1 with the backfill.
type LegacyMoveMarkCleared struct {
    mover: u64
}
type LegacyMoveMark union {
    LegacyMoveMarkMoving |
    LegacyMoveMarkMoved |
    LegacyMoveMarkCopyDestroyed |
    LegacyMoveMarkCleared
}

type ActorState struct {
    phase: ActorPhase
    epoch: u32
    createUnixMs: i64
    storageOrigin: StorageOrigin
    commandIndex: i64
    indexBucketCount: u64
    pendingAction: PendingAction
    writeIndex: WriteIndexEffectData
    startWaiters: list<StartWaiter>
    # The incarnation of the lazily forked state volume this state was last reset for. An
    # inherited state whose volume's incarnation differs is reset before its first event.
    forkReset: optional<UuidV4>
    databaseOrigin: ActorDatabaseOrigin
    # Legacy: the backfill's mark on this actor; see `LegacyMoveMark`. Removed in 3.1 with the
    # backfill.
    legacyMove: optional<LegacyMoveMark>
    # Legacy: the namespace of an ungrouped actor, as its record's `legacyNamespace` names it, so
    # the state of a legacy actor still downgrades to version 3 during a rolling deploy. Absent
    # for a grouped actor. Removed in 3.1 with the backfill.
    legacyNamespace: optional<str>
}

type ReserveEpoxyTimeout struct {
    attempt: u32
    createUnixMs: i64
}

type WriteIndexTimeout struct {
    attempt: u32
    createUnixMs: i64
}

type DestroyTimeout struct {
    attempt: u32
    createUnixMs: i64
}

type StartTimeout struct {
    epoch: u32
}

type StopTimeout struct {
    epoch: u32
}

type AlarmTimeout void

# Runs the envoy check again for the running `epoch` in case the process running the check an
# alarm started died with it. Armed with that check, past the envoy's lost threshold.
type EnvoyCheckTimeout struct {
    epoch: u32
}

# Ends the stopping `epoch` as lost when its stop is still unanswered past the stop threshold
# and its margin. Armed once, when the epoch begins stopping at `stopUnixMs`; resends of the
# stop do not move it.
type StopThresholdTimeout struct {
    epoch: u32
    stopUnixMs: i64
}

# Retries only the replacement allocation after the old epoch confirmed it stopped, so it
# never replaces the actor's own alarm. `attempt` drives the backoff.
type AllocationRetry struct {
    epoch: u32
    attempt: u32
}

type ForkDatabaseTimeout struct {
    attempt: u32
    createUnixMs: i64
}

# Armed by a `ForkDatabaseRefused` for the current attempt, no sooner than the refusal's hint
# and after a jittered backoff that doubles with each refusal in a row, up to a cap. When it fires
# for the current attempt, the fork sends its current step again under the same attempt: a
# refusal is not a failure, so it never counts against the attempt cap.
type ForkDatabaseRetry struct {
    attempt: u32
    createUnixMs: i64
}

# Legacy: armed with a `LegacyMoveMarkMoving` of `mover` for the mark's duration. When it fires
# while that mark is still held, the mark ends and a deferred alarm fires; any other mark, or
# none, is left alone. Removed in 3.1 with the backfill.
type LegacyMovingTimeout struct {
    mover: u64
}

type ActorTimer union {
    ReserveEpoxyTimeout |
    WriteIndexTimeout |
    DestroyTimeout |
    StartTimeout |
    AlarmTimeout |
    StopTimeout |
    EnvoyCheckTimeout |
    StopThresholdTimeout |
    AllocationRetry |
    ForkDatabaseTimeout |
    ForkDatabaseRetry |
    LegacyMovingTimeout
}

type StartFailed struct {
    epoch: u32
}

# The actor executor found the envoy of `epoch` disconnected past its lost threshold while its
# stop went undelivered, so the envoy has stopped every actor it held.
type EnvoyGone struct {
    epoch: u32
}

type Sleep void

type TryStart struct {
    waiter: optional<StartWaiter>
}

# `forceActorV3` asks for the actor in this cluster while its namespace migrates in from V2,
# whatever `create_ratio` says, unless its key already belongs to V2.
type Create struct {
    init: ActorCreateData
    waiter: optional<StartWaiter>
    forceActorV3: bool
}

type Reallocate struct {
    epoch: u32
    lost: bool
    waiter: optional<StartWaiter>
}

type UpdateRoute struct {
    epoch: u32
    from: ActorAllocation
    to: ActorAllocation
}

type Destroy void

type ToEnvoyEventKindRunning void

type ToEnvoyEventKindStopped struct {
    ok: bool
    message: optional<str>
}

type ToEnvoyEventKindSleepIntent void

type ToEnvoyEventKindStopIntent void

type ToEnvoyEventKindSetAlarm struct {
    alarmUnixMs: optional<i64>
}

type ToEnvoyEventKind union {
    ToEnvoyEventKindRunning |
    ToEnvoyEventKindStopped |
    ToEnvoyEventKindSleepIntent |
    ToEnvoyEventKindStopIntent |
    ToEnvoyEventKindSetAlarm
}

type ToEnvoyEvent struct {
    epoch: u32
    kind: ToEnvoyEventKind
}

# A destroyed actor starts a new incarnation held as `MigratingFromV2`, with its data record
# written in the same commit and its storage marked imported. `createUnixMs` is V2's creation
# time, raised past the previous incarnation's if needed. A held actor with an older id is taken
# over; any other phase is left unchanged.
type MigrateFromV2Begin struct {
    migrationId: u64
    init: ActorCreateData
    createUnixMs: i64
}

# V2 gave the actor up: a held actor with this id and its key reserved sleeps, with its index
# entry written, or is destroyed if a destroy arrived while it was held. `alarmUnixMs` replaces
# the actor's alarm; without it the actor keeps its own, and one that came due while it was held
# fires at once.
# Any other phase is left unchanged. A reservation that ran out of attempts or found another
# owner never settles, so the migrator discards that hold and imports the actor again.
type MigrateFromV2Activate struct {
    migrationId: u64
    alarmUnixMs: optional<i64>
}

# A held actor with this id is destroyed, which deletes its imported database. Any other phase
# is left unchanged.
type MigrateFromV2Discard struct {
    migrationId: u64
}

# A sleeping actor is held again under this id, so it can be handed back to V2. Any other phase
# is left unchanged.
type MigrateFromV2Recall struct {
    migrationId: u64
}

type MigrateFromV2 union {
    MigrateFromV2Begin |
    MigrateFromV2Activate |
    MigrateFromV2Discard |
    MigrateFromV2Recall
}

# An event. When: the actor executor's step was refused for now: the destination's job is busy,
# the source lags or its tail is unproven, or a base or route is briefly unavailable. State: none;
# the body is kept, since a refusal does not prove nothing ran, and the attempt is not consumed.
# `forkDatabase.refusals` counts it, and `forkDatabase.tailUnprovenRefusals` counts it when
# `tailUnproven` is set and resets otherwise. Effects: the current attempt's timeout is cancelled
# and `ForkDatabaseRetry` is armed no sooner than `retryAfterMs`, after a capped, jittered backoff
# that grows with `refusals`; there the same step is sent again under the same attempt. A
# refusal for another incarnation or attempt changes nothing. Permanent Depot answers (a
# missing, deleted or existing volume, an archived group) are reported as `Failed`, never as
# refusals.
type ForkDatabaseRefused struct {
    attempt: u32
    retryAfterMs: u32
    createUnixMs: i64
    # Depot refused the fork because the source's tail is unproven: its members hold entries
    # above what they prove committed, which a recovery of the source or a committed entry of
    # its holder's claim proves.
    tailUnproven: bool
}

# Legacy: an event. When: the backfill sends it to a moved actor once its key is reserved and
# its database copied, after it proved its claim on the old database still held and the old
# actor's destroy committed. `oldEpoch` is the old actor's epoch read after that destroy, which
# no later start of the old actor can pass. State: accepted only for the current incarnation
# (`createUnixMs`) of the hold's own mover while `Initializing.legacyMove` is present and the
# key is reserved and the database copied; the hold is dropped and the epoch raised above `oldEpoch`, so the moved
# actor's generations never coincide with the old actor's on an envoy, which keys actors by id
# and generation. Anything else changes nothing. Effects: arms the carried alarm, then ends
# initialization: a start to the envoy selected for the confirm, else to the one a request
# stored during the move, or sleep. The page reads the copy back to learn it was accepted.
# Removed in 3.1 with the backfill.
type LegacyMoveConfirm struct {
    createUnixMs: i64
    oldEpoch: u32
    # Must equal `LegacyMoveHold.mover`: only the move whose claim check passed confirms.
    mover: u64
}

# Legacy: an event. When: a backfill page sends it to an unprefixed actor before it claims the
# actor's database to move it. `mover` is the page's token, which grows with every page the
# namespace sends, so a page sent later always holds a higher one. State: sets
# `ActorState.legacyMove` to `LegacyMoveMarkMoving { mover }`, until `forMs` from now, unless
# the actor is being destroyed or holds a mark of a higher mover; an alarm the replaced mark
# deferred is kept. The page reads the actor back to learn whether it holds the mark. Effects:
# arms `LegacyMovingTimeout` for the mark's end and cancels the replaced mark's. Removed in 3.1
# with the backfill.
type LegacyMarkMoving struct {
    mover: u64
    forMs: u64
}

# Legacy: an event. When: a backfill page whose move failed, or that gave up on the actor, ends
# its mark. State: clears a `LegacyMoveMarkMoving` of `mover` or a lower one; anything else is
# kept. Effects: cancels the mark's `LegacyMovingTimeout`, and fires an alarm the mark deferred,
# which wakes the actor. Removed in 3.1 with the backfill.
type LegacyClearMoving struct {
    mover: u64
}

# Legacy: an event. When: a backfill move destroys the old actor after its claim check passed,
# or destroys a legacy duplicate. State: accepted only while the actor holds
# `LegacyMoveMarkMoving { mover }`: the mark becomes `LegacyMoveMarkMoved { mover }` and the
# actor is destroyed as by `Destroy`. Anything else, including a newer mover's mark or an
# ordinary destroy in between, changes nothing, and the page reads that back. Effects: those of
# `Destroy`. Removed in 3.1 with the backfill.
type LegacyMoveDestroy struct {
    mover: u64
}

# Legacy: an event. When: a backfill page destroys a moved copy that an earlier or failed
# attempt left held. State: accepted only for the incarnation `createUnixMs` while it is held and
# `mover` is at least the copy's `LegacyMoveHold.mover`; it is destroyed as by `Destroy`, with
# no mark. Anything else changes nothing. Effects: those of `Destroy`. Removed in 3.1 with the
# backfill.
type LegacyMoveAbandon struct {
    createUnixMs: i64
    mover: u64
}

type ActorEvent union {
    ReserveEpoxyState |
    WriteIndexState |
    StartFailed |
    Sleep |
    TryStart |
    Create |
    Reallocate |
    UpdateRoute |
    Destroy |
    DestroyState |
    ToEnvoyEvent |
    EnvoyGone |
    MigrateFromV2 |
    ForkDatabaseState |
    ForkDatabaseRefused |
    LegacyMoveConfirm |
    LegacyMarkMoving |
    LegacyClearMoving |
    LegacyMoveDestroy |
    LegacyMoveAbandon
}

type TryStartWaiting void

type TryStartStarting struct {
    epoch: u32
    allocation: ActorAllocation
}

type TryStartRunning struct {
    epoch: u32
    allocation: ActorAllocation
}

type TryStartDestroyed void

type TryStartEpoxyAlreadyReserved struct {
    reservationId: Id
}

type TryStartFull void

# The V2 migrator holds the actor, so V2 still serves it. No waiter is stored.
type TryStartMigratingFromV2 void

# The key is delegated to V2, so V2 serves it. No waiter is stored.
type TryStartDelegatedToV2 void

# Legacy: the actor is being moved into its namespace's group by the backfill, so the wake
# started nothing and stored no waiter. The caller retries shortly and resolves the actor again,
# which finds its new id once the move made it. Removed in 3.1 with the backfill.
type TryStartLegacyMoving void

type TryStartOutcome union {
    TryStartWaiting |
    TryStartStarting |
    TryStartRunning |
    TryStartDestroyed |
    TryStartEpoxyAlreadyReserved |
    TryStartFull |
    TryStartMigratingFromV2 |
    TryStartDelegatedToV2 |
    TryStartLegacyMoving
}

type ActorReadRequest void
type ActorReadResponse struct {
    data: optional<ActorData>
    phase: optional<ActorPhase>
    epoch: u32
    # How the current incarnation's database began, so a fork request can tell why its actor
    # was destroyed. Absent when the actor has no data yet.
    databaseOrigin: optional<ActorDatabaseOrigin>
    # The current incarnation's command index: 0 until its first start command is sent, so no
    # runner has created its database volume yet. Absent when the actor has no data yet, or
    # when the response was upgraded from version 3 or older, which did not report it.
    commandIndex: optional<i64>
    # Legacy: the backfill's mark; see `LegacyMoveMark`. Removed in 3.1 with the backfill.
    legacyMove: optional<LegacyMoveMark>
    # Legacy: the phase of the current incarnation's index write, so the V2 migrator settles an
    # activation at the legacy placement only once the actor's legacy index entry, which the
    # backfill's walk lists, is written. Absent when the actor has no state, or when the
    # response was upgraded from version 3 or older, which did not report it. Removed in 3.1
    # with the backfill.
    legacyWriteIndexPhase: optional<WriteIndexPhase>
}

type ActorEventResponse struct {
    outcome: optional<TryStartOutcome>
}

type ActorMigrateFromV2BeginResponse struct {
    phase: ActorPhase
    createUnixMs: i64
    # Legacy: the held actor's `ActorState.legacyNamespace`, so the begin of an ungrouped actor
    # still downgrades to version 3 during a rolling deploy. Absent for a grouped actor. Removed
    # in 3.1 with the backfill.
    legacyNamespace: optional<str>
}

type ActorCreateRequest struct {
    init: ActorCreateData
    waiter: optional<StartWaiter>
    forceActorV3: bool
}
type ActorCreateResponse struct {
    outcome: TryStartOutcome
}

type ActorStartNoticeStarting struct {
    epoch: u32
    allocation: ActorAllocation
}

type ActorStartNoticeRunning struct {
    epoch: u32
    allocation: ActorAllocation
}

type ActorStartNoticeEpoxyAlreadyReserved struct {
    reservationId: Id
}

type ActorStartNoticeDestroyed void

# The V2 migrator recalled the actor, so V2 serves it again and the waiter's request goes there.
type ActorStartNoticeMigratingFromV2 void

# The key belongs to V2, so the waiter's request goes there.
type ActorStartNoticeDelegatedToV2 void

# The forked actor's database fork finished. Sent to every stored waiter when the fork's
# outcome is written, before the actor has a node to start on, so a fork create answers as soon
# as the copy finished; the waiters stay stored for the start. A failed fork is reported by the
# destroy that follows it. Only a fork create's request, which a worker reading version 4
# registers, needs it; a waiter of an older worker is not sent one.
type ActorStartNoticeForked void

type ActorStartNoticeKind union {
    ActorStartNoticeStarting |
    ActorStartNoticeRunning |
    ActorStartNoticeEpoxyAlreadyReserved |
    ActorStartNoticeDestroyed |
    ActorStartNoticeMigratingFromV2 |
    ActorStartNoticeDelegatedToV2 |
    ActorStartNoticeForked
}

type ActorStartNotice struct {
    actorId: Id
    kind: ActorStartNoticeKind
}

type KvValue struct {
    value: data
    version: data
    updatedUnixMs: i64
}

