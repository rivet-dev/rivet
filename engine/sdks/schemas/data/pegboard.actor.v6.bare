# Pool settings are captured when a connection registers. Metadata is opaque JSON.
type NodePoolConfig struct {
    drainOnVersionUpgrade: bool
    actorEvictionDelay: u32
    actorEvictionPeriod: u32
    actorEvictionRate: f64
    metadata: optional<data>
}

type PoolConnection struct {
    connectionId: Id
    heartbeatUnixMs: i64
}

type PoolRead void

type PoolPut NodePoolConfig

type PoolDelete void

type PoolConnect PoolConnection

type PoolRenew PoolConnection

type PoolDisconnect Uuid

type PoolOperation union {
    PoolRead |
    PoolPut |
    PoolDelete |
    PoolConnect |
    PoolDisconnect |
    PoolRenew
}

type PoolStatus enum {
    OK
    NOT_FOUND
    CONNECTED
}

type PoolRequest struct {
    poolName: str
    operation: PoolOperation
}
type PoolResponse struct {
    status: PoolStatus
    config: optional<NodePoolConfig>
}

type PoolLease struct {
    heartbeatUnixMs: i64
    }

# One bounded page of configured pools, ordered by immutable name.
type PoolEntry struct {
    name: str
    config: NodePoolConfig
}

type PoolListRequest struct {
    after: optional<str>
    limit: u32
}
type PoolListResponse struct {
    pools: list<PoolEntry>
    cursor: optional<str>
}

# Legacy: reads when an actor's scheduled alarm fires, from its state volume, so the backfill
# carries it into the actor's moved copy. Absent when no alarm is scheduled. Removed in 3.1 with
# the backfill.
type LegacyActorAlarmReadRequest void
type LegacyActorAlarmReadResponse struct {
    alarmUnixMs: optional<i64>
}
