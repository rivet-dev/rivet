{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"lib": ["ESNext", "DOM"],
		"types": ["node"],
		"jsx": "react-jsx"
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": [
		"node_modules",
		"actors-quickstart-next-js",
		"general-http-server/elysia-handler.ts",
		"general-http-server/hono-handler.ts",
		"general-http-server/serve.ts",
		"actors-actions/calling-backend.ts"
	]
}
